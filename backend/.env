#SMSGatewayHub

# Set to 'false' to send real SMS using the gateway in development, or 'true' to mock SMS
SMS_GATEWAY_MOCK=false

# Set the provider specifically to SMSGatewayHub
SMS_GATEWAY_PROVIDER=smsgatewayhub

# Your unique API Key generated in your SMSGatewayHub dashboard (under API Settings)
SMS_GATEWAY_API_KEY=VDd6UMYVYkaIzG8kNt1SvQ

# Your approved 6-character Sender ID (e.g., 'SMPLSH')
SMS_GATEWAY_SENDER_ID=SMPLSH

# Your approved Route ID (typically '1' or '2' for transaction/promotional routes)
SMS_GATEWAY_ROUTE=47

# SMS_GATEWAY_URL=https://www.smsgatewayhub.com/api/mt/SendSMS

# DLT Regulations Parameters
# PEID = Principal Entity ID from SMSGatewayHub > Resources > Manage SenderID panel
# (NOT the Airtel Brand DLT ID — those are different numbers)
