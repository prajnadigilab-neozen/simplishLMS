# Template IDs from SMSGatewayHub > Resources > Manage Template panel
SMS_GATEWAY_TEMPLATE_ID=1007519025702036703
SMS_GATEWAY_EXPIRY_TEMPLATE_ID=1007339779042786673
SMS_GATEWAY_RESET_TEMPLATE_ID=1007988218577150702

# App name as registered in the Airtel DLT template (MUST be exact match).
# WARNING: Do NOT change this — 'SIMPLISH' caused error 7003. 'Simplish LMS' is DLT-approved.
# Note: smsService.js now hardcodes this value; this env var is kept only for reference.
SMS_GATEWAY_APP_NAME=Simplish LMS

